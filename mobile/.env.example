# Leave empty for the clearly labeled, local-only demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Native keys are compiled into the app; restrict each to its application ID.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Optional browser review; without this the browser uses OpenStreetMap.
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
