<?xml version="1.0" encoding="utf-8"?>
<!-- Android masks splash icons to a 192dp circle inside a 288dp canvas.
     Keep the entire tall pin, including its drips, well inside that circle. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="28%"
    android:insetRight="28%"
    android:insetTop="22%"
    android:insetBottom="22%">
    <bitmap android:src="@drawable/launch_pin" android:gravity="fill" android:filter="true" />
</inset>
